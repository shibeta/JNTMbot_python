{
    "name": "steam_bot",
    "version": "1.0.0",
    "description": "将 node-steam-user 的群组聊天功能封装为 HTTP 后端",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "pkg . --out-path ./dist/"
    },
    "bin": "server.js",
    "author": "shibeta",
    "license": "ISC",
    "engines": {
        "node": ">=22.23.4"
    },
    "pkg": {
        "targets": [
            "node22-win-x64"
        ],
        "assets": [
            "node_modules/lzma/**",
            "node_modules/@doctormckay/steam-crypto/system.pem"
        ]
    },
    "dependencies": {
        "express": "^5.2.0",
        "prompts": "^2.4.2",
        "steam-user": "^5.3.0"
    },
    "devDependencies": {
        "@yao-pkg/pkg": "^6.24.0"
    },
    "overrides": {
        "adm-zip": "^0.6.1",
        "protobufjs": "^7.6.6"
    }
}